{
  "name": "graph-agent",
  "description": "Local-first dynamic DAG orchestration for AI agents",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @graph-agent/web dev",
    "start": "pnpm --filter @graph-agent/web start",
    "build": "pnpm --filter @graph-agent/web build",
    "deck:dev": "pnpm --filter @graph-agent/deck dev",
    "deck:build": "pnpm --filter @graph-agent/deck build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  }
}
